  {
   "t0": 0.0,
   "t1": 2.5,
   "ko": "OpenAI가 {9월}에|이걸 보여 주는 글을 올렸는데요",
   "en": "OpenAI published a blog post about this in September,",
   "sub": "OpenAI가 9월에 이걸\n보여 주는 글을 올렸는데요"
  },
  {
   "t0": 2.6,
   "t1": 7.8,
   "ko": "OpenAI 연구원 중|AI를 가장 많이 쓰는|{상위 10%}가",
   "en": "the heaviest 10% of AI users amongst OpenAI's researchers",
   "sub": "OpenAI 연구원 중\nAI를 가장 많이 쓰는 상위 10%가"
  },
  {
   "t0": 7.8,
   "t1": 12.7,
   "ko": "여름 초에는 하루 약 {1,000달러}어치|코딩 에이전트를 쓰다가",
   "en": "went from about $1,000 a day of internal coding agents",
   "sub": "여름 초에는 하루 약 1,000달러어치\n코딩 에이전트를 쓰다가"
  },
  {
   "t0": 12.7,
   "t1": 16.3,
   "ko": "8월 말에는 하루|{7,000달러} 넘게|쓰게 됐다고 해요",
   "en": "to over $7,000 a day by the end of August.",
   "sub": "8월 말에는 하루 7,000달러\n넘게 쓰게 됐다고 해요"
  },
  {
   "t0": 16.6,
   "t1": 21.3,
   "ko": "{앤트로픽}도 9월에|비슷한 글을 냈는데요",
   "en": "And also in September, Anthropic put out a similar post.",
   "sub": "앤트로픽도 9월에\n비슷한 글을 냈는데요"
  },
  {
   "t0": 21.7,
   "t1": 27.1,
   "ko": "지금은 앤트로픽 AI 연구개발의|{26%}를 Claude가 이끌고 있대요",
   "en": "Claude now leads 26% of Anthropic's AI R&D work,",
   "sub": "지금은 앤트로픽 AI 연구개발의\n26%를 Claude가 이끌고 있대요"
  },
  {
   "t0": 27.1,
   "t1": 30.5,
   "ko": "2월만 해도|{1% 미만}이었는데 말이죠",
   "en": "up from under 1% as recently as February.",
   "sub": "2월만 해도\n1% 미만이었는데 말이죠"
